# Clé d'API Anthropic — UNIQUEMENT côté serveur, jamais exposée au navigateur.
ANTHROPIC_API_KEY=sk-ant-...

# Port d'écoute (défaut 3000). Le serveur écoute sur toutes les interfaces :
# l'adresse réseau affichée au démarrage permet de jouer depuis un téléphone.
PORT=3000

# --- Réglages IA (facultatifs) ---------------------------------------------
# Modèle utilisé pour l'arbitrage (défaut : claude-opus-5)
BACRUSH_AI_MODEL=claude-opus-5
# Profondeur de réflexion : low | medium | high | xhigh | max
BACRUSH_AI_EFFORT=medium
BACRUSH_AI_SEARCH_EFFORT=high
# Recherche web pour les cas douteux : 'off' pour la désactiver
BACRUSH_AI_SEARCH=on
BACRUSH_AI_MAX_SEARCHES=6
# Échéances (ms) : au-delà, la validation de secours prend le relais
BACRUSH_AI_TIMEOUT_MS=40000
BACRUSH_AI_SEARCH_TIMEOUT_MS=45000
BACRUSH_AI_DEADLINE_MS=75000
# 'off' force le mode secours (aucun appel réseau)
BACRUSH_AI=auto
# Réponses réellement indéterminées : lenient (comptées, signalées) | strict (refusées)
BACRUSH_UNCERTAIN_POLICY=lenient
